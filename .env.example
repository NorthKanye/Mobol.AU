# Required for /api/chat — the AI SDK reads this directly via
# @ai-sdk/openai. Do NOT prefix with NEXT_PUBLIC_; the key must stay
# server-side. Copy this file to .env.local and fill in the value.
OPENAI_API_KEY=

# Optional — overrides the default chat model (gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Required for /contact email delivery via Resend. The public mailbox
# (hello@mobol.com.au) stays on iCloud — Resend is outbound only and is
# never shown to visitors.
#
# CONTACT_TO_EMAIL — must match the email you used to create your Resend
# account while we're on the sandbox sender below. The account was created
# with kyle@mobol.com.au, so that's the delivery target. Once a domain is
# verified in Resend, this can become hello@mobol.com.au.
#
# CONTACT_FROM_EMAIL — pick one:
#   • No-DNS path (current default): "Mobol Contact <onboarding@resend.dev>"
#     Resend's sandbox sender. Only delivers to the Resend account email
#     (kyle@mobol.com.au), which is fine for "form → my inbox".
#   • Branded sender (later, if you want): "Mobol Contact <forms@mail.mobol.com.au>"
#     after verifying the mail.mobol.com.au subdomain in Resend. The
#     records Resend asks for (TXT/CNAME, and an MX on the subdomain
#     for bounces) live on the subdomain only — they do NOT replace or
#     conflict with the root mobol.com.au MX records that route inbound
#     mail to iCloud.
RESEND_API_KEY=
CONTACT_TO_EMAIL=kyle@mobol.com.au
CONTACT_FROM_EMAIL="Mobol Contact <onboarding@resend.dev>"
