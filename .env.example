# Required for /api/chat — the AI SDK reads this directly via
# @ai-sdk/openai. Do NOT prefix with NEXT_PUBLIC_; the key must stay
# server-side. Copy this file to .env.local and fill in the value.
OPENAI_API_KEY=

# Optional — overrides the default chat model (gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
